# Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./policy_data.db

# LLM Providers (Choices: mock, openai, gemini, fallback)
# Set to 'fallback' to try openai and automatically fallback to gemini on error.
# Set to 'mock' to run the entire system offline without requiring any api keys.
LLM_PROVIDER=mock

# LLM API Keys (Optional if LLM_PROVIDER is set to 'mock')
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
