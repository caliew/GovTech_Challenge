# ─────────────────────────────────────────────────────────────────────────────
# GovTech Policy Analytics Platform — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env to git.

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./policy_data.db

# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider Selection
# ─────────────────────────────────────────────────────────────────────────────
# Options:
#   mock     — Fully offline. No API key needed. Uses high-fidelity mock engine.
#   gemini   — Google Gemini 2.5 Flash. Uses GEMINI_API_KEY.
#   openai   — OpenAI GPT-4o Mini. Uses OPENAI_API_KEY.
#   xai      — xAI Grok 3 Mini. Uses XAI_API_KEY.
#   fallback — Tries OpenAI → xAI (Grok) → Gemini → Mock in order.
#              Best for production resilience. Falls back automatically on quota errors.
#
# IMPORTANT: All providers (gemini, openai, xai) gracefully fall back to Mock
# if their API call fails (e.g. 429 quota exceeded). The platform never crashes.
LLM_PROVIDER=mock

# ─────────────────────────────────────────────────────────────────────────────
# LLM API Keys — Leave blank for any providers you are not using.
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini — Free tier available. Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI — Pay-as-you-go. Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# xAI Grok — Pay-as-you-go (OpenAI-compatible API). Get key at: https://console.x.ai
XAI_API_KEY=your_xai_grok_api_key_here
